---
import { canberraParts, canberraWallTimeToEpochMs, nextReloadTargetEpochMs, shiftDate } from "../lib/clock";
import { listBookingsForDate, listRooms } from "../lib/db";
import { roomForName } from "../lib/floorplan";
import { DURATIONS, lengthLabel } from "../lib/timeslots";
import MyWeek from "../components/MyWeek.astro";
import "../styles.css";
import "../styles/booking-form.css";

// All times on this board are Canberra wall-clock text (see src/lib/schema.ts)
// — "now" has to be read the same way, regardless of what timezone the
// machine running the server happens to be in.
const { date: today, time: nowTime } = canberraParts(new Date());
const requestedDate = Astro.url.searchParams.get("date");
const date = requestedDate && /^\d{4}-\d{2}-\d{2}$/.test(requestedDate) ? requestedDate : today;
const isToday = date === today;
const error = Astro.url.searchParams.get("error");

const errorMessages: Record<string, string> = {
  conflict: "That room is already booked for part of this time — pick another slot.",
  date: "That's not a date the board understands — pick one from the calendar.",
  invalid: "The end time has to be after the start time.",
  name: "Enter your name so the room knows who's got it.",
  room: "Pick a room.",
};

const rooms = listRooms();
const bookingsForDate = listBookingsForDate(date);
// Whether "now" falls inside a booking is decided here, in plain TS, and
// carried on the data — the Astro compiler reads a bare `<` inside a JSX-like
// expression as the start of a tag, so that comparison can't live inline in
// the template below.
const isNowWithin = (start: string, end: string) => isToday && start <= nowTime && nowTime < end;
const roomsWithBookings = rooms.map((room) => ({
  room,
  bookings: bookingsForDate
    .filter((b) => b.roomId === room.id)
    .map((b) => ({ ...b, active: isNowWithin(b.startTime, b.endTime) })),
}));

// The same answer, placed on the floor: every board room that has a room on
// Chifley Level 3's plan, with whether (and by whom) it's in use right now.
// src/scripts/floor3d.ts draws it; the caption says it in words.
const onFloor = roomsWithBookings.flatMap(({ room, bookings }) => {
  const place = roomForName(room.name);
  if (!place) return [];
  const now = bookings.find((b) => b.active);
  return [
    {
      id: room.id,
      code: place.code,
      active: Boolean(now),
      who: now?.bookedBy ?? null,
      bookings: bookings.map(({ startTime, endTime, bookedBy }) => ({ startTime, endTime, bookedBy })),
    },
  ];
});
const inUseNow = onFloor.filter((r) => r.active).map((r) => r.code);

// What the booking form needs to preview a booking before it's sent: each
// room's door code and its bookings for this date. src/scripts/booking-form.ts
// reads it to draw the chosen room's timeline and warn about a clash; the
// server (src/pages/api/bookings.ts) still has the final say on both.
const codeFor = (name: string) => roomForName(name)?.code ?? name;
const dayFormat = (options: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat("en-AU", { ...options, timeZone: "UTC" }).format(new Date(`${date}T00:00:00Z`));
const longDate = dayFormat({ weekday: "long", day: "numeric", month: "long" });
const shortDate = dayFormat({ weekday: "short", day: "numeric", month: "short" });
const relativeDay = isToday
  ? "today"
  : date === shiftDate(today, 1)
    ? "tomorrow"
    : date === shiftDate(today, -1)
      ? "yesterday"
      : null;
const roomChoices = roomsWithBookings.map(({ room, bookings }) => {
  const inUseNow = bookings.some((b) => b.active);
  const count = bookings.length === 0 ? "No bookings" : `${bookings.length} booked`;
  return {
    id: room.id,
    code: codeFor(room.name),
    inUseNow,
    status: isToday && inUseNow ? "In use now" : count,
  };
});
const bookingData = {
  date,
  isToday,
  isPast: date < today,
  day: relativeDay ?? shortDate,
  rooms: roomsWithBookings.map(({ room, bookings }) => ({
    id: room.id,
    code: codeFor(room.name),
    bookings: bookings.map((b) => ({ start: b.startTime, end: b.endTime, active: b.active })),
  })),
};

// Passed to the client script below so a tab left open across a booking's
// start/end minute — or across midnight, with no bookings left to wait for
// today — reloads itself right then, instead of only when some other tab's
// booking happens to trigger the SSE reload. A tab parked on *tomorrow*'s
// view gets the same treatment for the one boundary that matters to it: the
// moment real midnight arrives, this date stops being tomorrow and becomes
// today, so its "(today)" label and live highlighting need to switch on —
// any date further out has no near-term boundary worth waiting for.
//
// This is the real UTC instant of that boundary, not a minute count: a
// minute count handed to the client's own setTimeout would assume a
// wall-clock minute is always a real minute, which is false on the two
// nights a year Canberra's clocks shift for daylight saving (see
// canberraWallTimeToEpochMs in src/lib/clock.ts) — the client instead
// computes its own delay as target-minus-now at load time.
const nextBoundaryTarget = isToday
  ? nextReloadTargetEpochMs(date, nowTime, bookingsForDate.flatMap((b) => [b.startTime, b.endTime]))
  : date === shiftDate(today, 1)
    ? canberraWallTimeToEpochMs(date, "00:00")
    : null;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="A live board for ANU Library group study rooms — book a slot, see who's got a room right now, cancel one you don't need."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Room board</title>
  </head>
  <body>
    <nav aria-label="site" class="jump">
      <a href="#top" class="jump__brand">Room board</a>
      <a href="#floor" class="jump__btn">Floor</a>
      <a href="#book" class="jump__btn">Book</a>
      <a href="#rooms" class="jump__btn">Today's rooms</a>
      <a href="#my-week" class="jump__btn">My week</a>
      <a href="/readme/" class="jump__btn jump__btn--quiet">About</a>
    </nav>
    <main id="top">
      <h1>Room board</h1>
      <p>
        A shared, live view of a handful of ANU Library group study rooms: who's booked what, and what's free — see
        the <a href="/readme/">About page</a> for what this prototype is standing in for.
      </p>

      <nav aria-label="date" class="datenav">
        <a href={`/?date=${shiftDate(date, -1)}`}>&larr; {shiftDate(date, -1)}</a>
        <strong>{date}{isToday ? " (today)" : ""}</strong>
        <a href={`/?date=${shiftDate(date, 1)}`}>{shiftDate(date, 1)} &rarr;</a>
      </nav>
      {/* Filled in by src/scripts/board-live.ts. With scripts off the page is a
          snapshot, so it stays hidden. data-next-boundary is the same instant
          the inline script below waits for, carried as data so a patched-in
          render can hand its own next boundary to the live script. */}
      <p class="board-live" data-next-boundary={nextBoundaryTarget ?? ""} hidden></p>

      <div class="cta">
        <a href="#book" class="cta__btn cta__btn--primary">Book a room</a>
        <a href="#my-week" class="cta__btn">See my week</a>
        <a href="#floor" class="cta__btn">Find it on the floor</a>
      </div>

      <figure id="floor" class="floor3d" data-rooms={JSON.stringify(onFloor)} data-date={date}>
        <div class="floor3d-stage"></div>
        {/* Filled by src/scripts/floor3d-time.ts and floor3d-route.ts once the model mounts. */}
        <div class="floor3d-time" hidden></div>
        <p class="floor3d-route" aria-live="polite" hidden></p>
        <figcaption>
          Chifley Library, Level 3{isToday ? "" : ` on ${date}`}.{" "}
          {!isToday
            ? "Rooms only light up for what's happening today."
            : inUseNow.length === 0
              ? "No group study room is in use right now."
              : `In use right now: ${inUseNow.join(", ")}.`}{" "}
          Drag to turn the floor; click a room to see its bookings.
        </figcaption>
      </figure>

      <form
        method="post"
        action="/api/bookings"
        class="book-form"
        id="book"
        aria-labelledby="book-heading"
        data-booking={JSON.stringify(bookingData)}
      >
        <header class="book-form__head">
          <h2 id="book-heading">Book a room</h2>
          <p class="book-form__day">
            <span>{longDate}</span>
            {relativeDay && <span class="book-form__rel">{relativeDay}</span>}
          </p>
        </header>

        {error && (
          <p class="error" role="alert">
            {errorMessages[error] ?? "Something went wrong — try again."}
          </p>
        )}
        <p class="book-form__done" role="status"></p>

        <input type="hidden" name="date" value={date} />

        <div class="field field--select">
          <label for="roomId">Room</label>
          <select id="roomId" name="roomId" required>
            {rooms.map((room) => (
              <option value={room.id}>{room.name}</option>
            ))}
          </select>
        </div>

        <fieldset class="room-picker" hidden>
          <legend>Room</legend>
          <div class="room-picker__options">
            {roomChoices.map((choice, index) => (
              <label class="room-choice">
                <input type="radio" name="roomChoice" value={choice.id} checked={index === 0} />
                <span class="room-choice__code">{choice.code}</span>
                <span class="room-choice__status">
                  {choice.inUseNow && <span class="now-dot" aria-hidden="true" />}
                  {choice.status}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="field">
          <label for="bookedBy">Your name</label>
          <input id="bookedBy" name="bookedBy" required maxlength="80" autocomplete="name" />
        </div>

        <fieldset class="when">
          <legend>When</legend>
          <div class="timeline" hidden>
            <div class="timeline__bar" aria-hidden="true"></div>
            <div class="timeline__axis" aria-hidden="true"></div>
            <div class="timeline__free">
              <span class="timeline__label" id="free-label">Free</span>
              <div class="timeline__chips" role="group" aria-labelledby="free-label"></div>
            </div>
            <p class="timeline__taken"></p>
          </div>
          <div class="when__times">
            <div class="field">
              <label for="startTime">From</label>
              <input id="startTime" name="startTime" type="time" required aria-describedby="time-hint" />
            </div>
            <span class="when__dash" aria-hidden="true">–</span>
            <div class="field">
              <label for="endTime">To</label>
              <input id="endTime" name="endTime" type="time" required aria-describedby="time-hint" />
            </div>
          </div>
          <div class="durations" role="group" aria-label="Length" hidden>
            {DURATIONS.map((minutes) => (
              <button type="button" class="chip" data-minutes={minutes} aria-pressed="false">
                {lengthLabel(minutes)}
              </button>
            ))}
          </div>
          <p class="book-form__hint" id="time-hint" aria-live="polite"></p>
        </fieldset>

        <div class="book-form__foot">
          <p class="book-form__summary" hidden></p>
          <button type="submit" class="book-form__submit">Book for {relativeDay ?? shortDate}</button>
        </div>
      </form>

      <div id="rooms" class="rooms">
        {roomsWithBookings.map(({ room, bookings }) => (
          <section class="room" aria-labelledby={`room-${room.id}`}>
            <h2 id={`room-${room.id}`}>{room.name}</h2>
            <ul>
              {bookings.length === 0 && <li class="empty">Free all day</li>}
              {bookings.map((booking) => (
                <li class={booking.active ? "active" : undefined}>
                  <span class="time">
                    {booking.startTime}–{booking.endTime}
                  </span>
                  <span class="who">{booking.bookedBy}</span>
                  <form method="post" action={`/api/bookings/${booking.id}/cancel`}>
                    <input type="hidden" name="date" value={date} />
                    <button type="submit">Cancel</button>
                  </form>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <MyWeek />
    </main>
    <script is:inline define:vars={{ date, nextBoundaryTarget }}>
      // The board's live half: any tab looking at this same date brings itself
      // up to date the moment a booking is made or cancelled anywhere, so two
      // people looking at the same day never work from stale information.
      //
      // This inline script only notices *that* the board may be stale. Making
      // it fresh is src/scripts/board-live.ts's job: once loaded it installs
      // window.roomBoardLive, and every signal below is handed to it, so it can
      // re-fetch this page and patch the rooms list, the caption, the booking
      // form's data and the 3D model in place, with no reload to throw away
      // the camera, scroll position or anything half-typed. If that module
      // never loaded (an old browser, a failed request), the fallback is the
      // board's earlier behaviour: a full reload, which is always correct.
      const stale = (reason) => {
        const live = window.roomBoardLive;
        if (live) live.refresh(reason);
        else location.reload();
      };
      const source = new EventSource("/api/events");
      // board-live.ts closes this when the page submits one of its own forms,
      // so the tab never patches or reloads over its own POST + redirect.
      window.roomBoardSource = source;
      source.addEventListener("booking", (event) => {
        const payload = JSON.parse(event.data);
        if (payload.date === date) stale("booking");
      });

      // The SSE stream carries no state of its own, just a "something
      // changed" signal — so a connection that drops (a network blip, a
      // server restart on deploy) and reconnects has no way to know what it
      // missed while it was down. "open" fires on every reconnect as well as
      // the first connect; refresh on every one after the first, since by
      // then the only safe assumption is that something might have changed.
      let hasOpenedBefore = false;
      source.addEventListener("open", () => {
        if (hasOpenedBefore) stale("reconnect");
        hasOpenedBefore = true;
      });

      // The other half of "live": the "happening now" highlight and the
      // date-nav's "(today)" label are both computed once, at render time.
      // With no other tab ever booking or cancelling anything today, this
      // tab would otherwise keep showing that render's answer forever —
      // past the end of a highlighted slot, past midnight into a day this
      // render was never "today" for, or (on a tab left parked on tomorrow's
      // view) past midnight into the moment that date becomes today and
      // ought to switch its label and highlighting on. `nextBoundaryTarget`
      // (the real UTC instant of the next booking start/end today, of
      // midnight if nothing's left to wait for today, or of midnight if
      // this view is tomorrow's date) is computed server-side, correctly
      // across a Canberra daylight-saving transition — see
      // canberraWallTimeToEpochMs in src/lib/clock.ts. The client just
      // takes the delay from its own clock at load time, rather than
      // trusting a minute count computed at render time to still equal the
      // same number of real milliseconds by the time it fires.
      //
      // board-live.ts keeps its own boundary timer (every patch brings a new
      // next boundary, read from .board-live's data-next-boundary), so this
      // one only acts as the reload fallback when that module isn't there.
      if (nextBoundaryTarget !== null) {
        setTimeout(() => {
          if (!window.roomBoardLive) location.reload();
        }, Math.max(0, nextBoundaryTarget - Date.now()) + 5_000);
      }
    </script>
    <script>
      import "../scripts/floor3d";
      import "../scripts/floor3d-route";
      import "../scripts/floor3d-time";
    </script>
    <script>
      import "../scripts/booking-form";
    </script>
    <script>
      import "../scripts/board-live";
    </script>
  </body>
</html>
